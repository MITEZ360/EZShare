<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>EZShare</RootNamespace>
    <AssemblyName>EZShare</AssemblyName>
    <Version>0.0.8</Version>
    <AssemblyVersion>0.0.8.0</AssemblyVersion>
    <FileVersion>0.0.8.0</FileVersion>
    <InformationalVersion>0.0.8</InformationalVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\web.css" LogicalName="EZShare.Assets.web.css" />
    <EmbeddedResource Include="Assets\web.js" LogicalName="EZShare.Assets.web.js" />
    <None Include="Assets\web.css" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\web.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
