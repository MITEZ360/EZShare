<Window x:Class="EZShare.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EZShare" Height="660" Width="920"
        MinHeight="560" MinWidth="760"
        Background="#F7F7F7"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border x:Name="Header" Grid.Row="0" Background="#FAFAFA" Padding="22,16,22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#00C29A" Margin="0,0,10,0">
                        <TextBlock Text="⇧" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="EZShare" FontSize="15" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                        <TextBlock x:Name="ShareNameText" Text="EZShare" FontSize="11" Foreground="#808080"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="StatusPill" CornerRadius="12" Padding="11,6" Background="#E6F8F3" Margin="0,0,8,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#00C29A" Margin="0,0,6,0"/>
                            <TextBlock x:Name="StatusText" Text="未启动" FontSize="11.5" FontWeight="SemiBold" Foreground="#00C29A"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 标签栏 -->
        <Border Grid.Row="1" Background="#FAFAFA" Padding="22,0,22,0">
            <StackPanel x:Name="Tabs" Orientation="Horizontal">
                <Button x:Name="TabFiles" Content="文件" Tag="0" Style="{StaticResource TabActive}" Click="Tab_Click" Margin="0,0,6,0"/>
                <Button x:Name="TabTexts" Content="文本" Tag="1" Style="{StaticResource TabStyle}" Click="Tab_Click" Margin="0,0,6,0"/>
                <Button x:Name="TabDevices" Content="设备" Tag="2" Style="{StaticResource TabStyle}" Click="Tab_Click" Margin="0,0,6,0"/>
                <Button x:Name="TabSettings" Content="设置" Tag="3" Style="{StaticResource TabStyle}" Click="Tab_Click"/>
            </StackPanel>
        </Border>

        <!-- 内容区 -->
        <Border Grid.Row="2" Padding="20,16,20,16">
            <ContentControl x:Name="PageHost"/>
        </Border>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Background="#FAFAFA" Padding="22,9,22,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Text="局域网直连 · 不经云端" FontSize="11" Foreground="#808080" VerticalAlignment="Center"/>
                <TextBlock x:Name="PortText" Grid.Column="1" Text="端口 8080" FontSize="11" Foreground="#808080" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Toast -->
        <Border x:Name="Toast" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="White" CornerRadius="12" Padding="14,10" Margin="0,0,0,24"
                Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Text="" Foreground="#1A1A1A" FontSize="12"/>
        </Border>
    </Grid>
</Window>
